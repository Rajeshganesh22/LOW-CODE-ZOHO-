				width = medium
			)
			Author
			(
    			type = text
	 			row = 1
	 			column = 1   
				width = medium
			)
			Category
			(
    			type = text
	 			row = 1
	 			column = 1   
				width = medium
			)
			Publisher
			(
    			type = text
	 			row = 1
	 			column = 1   
				width = medium
			)
			Branch
			(
    			type = text
	 			row = 1
	 			column = 1   
				width = medium
			)
			Shelf_Number
			(
    			type = text
				displayname = "Shelf Number"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Available_Copies
			(
				type = number
				displayname = "Available Copies"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Book_Condition
			(
    			type = text
				displayname = "Book Condition"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Librarian
			(
    			type = text
	 			row = 1
	 			column = 1   
				width = medium
			)
			Librarian_Email
			(
    			type = email
				displayname = "Librarian Email"
				maxchar = 80
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			Expected_Return_Date
			(
    			type = date
				displayname = "Expected Return Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Issue_Status
			(
				type = picklist
				displayname = "Issue Status"
				maxchar = 100
				values = {"Issued","Returned","Overdue","Lost"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Remarks
			(
    			type = textarea
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
