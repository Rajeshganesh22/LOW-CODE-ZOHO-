		workflow
		{
		form
		{
			WF1_Fetch_Book_Details as "WF1 - Fetch Book Details"
			{
				type =  form
				form = Book_Issue

				record event = on add or edit

				on user input of Book
				{
					actions 
					{
						custom deluge script
						(
											book_record = Book_Master[ID == input.Book];
										input.Author = book_record.Author;
										input.Category = book_record.Category;
										input.Publisher = book_record.Publisher;
										input.Branch = book_record.Branch;
										input.Shelf_Number = book_record.Shelf_Number;
										input.Available_Copies = book_record.Available_Copies;
										input.Book_Condition = book_record.Book_Condition;
						)
					}
				}

			}
			WF2_Reduce_Available_Copi as "WF2 - Reduce Available Copies"
			{
				type =  form
				form = Book_Issue

				record event = on add

				on success
				{
					actions  (Issue_Status == "Issued")
					{
						custom deluge script
						(
											book_record = Book_Master[ID == input.Book];
										if(book_record.Available_Copies > 0)
										{
											book_record.Available_Copies=book_record.Available_Copies - 1;
										}
						)
					}
				}

			}
			WF3_Update_Book_Master_on as "WF3 - Update Book Master on Return"
			{
				type =  form
				form = Book_Return

				record event = on add or edit

				on success
				{
					actions  (Return_Status == "Returned")
					{
						custom deluge script
						(
											if(input.Return_Status == "Returned")
										{
											book = Book_Master[ID == input.Book];
											if(book != null)
											{
												book.Available_Copies=book.Available_Copies + 1;
											}
										}
						)
					}
				}

			}
			WF5_Fetch_Member_Details as "WF5 - Fetch Member Details"
			{
				type =  form
				form = Book_Issue

				record event = on add or edit

				on user input of Member
				{
					actions 
					{
						custom deluge script
						(
											if(input.Member != null)
										{
											member_record = Member_Registration[ID == input.Member];
											input.Member_Email = member_record.Email;
											input.Membership_Type = member_record.Membership_Type;
											Membership_Expiry_Date = member_record.Membership_Expiry_Date;
											input.Branch = member_record.Branch;
										}
						)
					}
				}

			}
		}

		schedule
		{
			WF4_Notify_Overdue_Member as "WF4 - Notify Overdue Members"
			{
				type =  schedule
				form = Book_Issue[Issue_Status != "Returned"]
					status = inactive
				start = after 1 days from Expected_Return_Date at "22:00:00"
				time zone = "Asia/Kolkata"
				on start
				{
					actions  (Issue_Status != "Returned")
					{
						sendmail
						(
							from : "zoho.adminuserid"
							to : Member_Email
							subject : "Library Book Overdue"
							message : "<div>Dear ${Member}, <br></div><div><br></div><div>Your library book is overdue by more than 7 days.<br></div><div><br></div><div>Book: ${Book}<br></div><div>Expected Return Date: ${Expected_Return_Date}<br></div><div><br></div><div>Please return the book as soon as possible.<br></div><div><br></div><div>Thank you,<br></div><div>ABC Public Library<br></div>"
						)
					}
					actions  (Issue_Status != "Returned")
					{
						sendmail
						(
							from : "zoho.adminuserid"
							to : Librarian_Email
							subject : "Overdue Book Alert"
							message : "<div>Overdue Book Alert <br></div><div><br></div><div>Member: ${Member}<br></div><div>Book: ${Book}<br></div><div>Expected Return Date: ${Expected_Return_Date}<br></div><div><br></div><div>This book has been overdue for more than 7 days.<br></div><div>Please follow up with the member.<br></div>"
						)
					}
				}
			}
		}




