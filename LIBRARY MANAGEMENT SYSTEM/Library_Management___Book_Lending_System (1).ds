		pivottable Pivot_Table
		{
			displayname = "Category-wise Books"
			based on Autoview_1787682274365_Book_Master
				show all rows from Book_Master
				(
			Book_ID  as "Book ID"
			ISBN_Number  as "ISBN Number"
			Book_Title  as "Book Title"
			Category 
			Author 
			Publisher 
			Branch 
