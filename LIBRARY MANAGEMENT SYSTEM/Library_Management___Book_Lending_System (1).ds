		form Book_Issue
		{
			displayname = "Book Issue"
			success message = "Issue Booked Successfully"
			feature property = 32
			encrypt_ip = true
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have Issue_Number
			(
    			type = text
				displayname = "Issue Number"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Issue_Date
			(
    			type = date
				displayname = "Issue Date"
				initial value = "08-Aug-2026"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Member
			(
				type = picklist	
				values  = Member_Registration.ID
    			displayformat = [" " + Member_Name.prefix + " " + Member_Name.first_name + " " + Member_Name.last_name + " " + Member_Name.suffix]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Member_Email
			(
    			type = email
