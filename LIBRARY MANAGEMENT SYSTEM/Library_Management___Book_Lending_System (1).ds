					width = medium
				)
				must have Shelf_Number
				(
    				type = text
					displayname = "Shelf Number"
					width = medium
				)
				must have Book_Condition
				(
					type = picklist
					displayname = "Book Condition"
					maxchar = 100
					values = {"New","Good","Fair","Damaged"}
					width = medium
				)
